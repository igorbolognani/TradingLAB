# Copy this file to .env.local and fill it locally.
# Never commit real OAuth credentials or tokens.

# Client ID and Client Secret from the Alpaca Connect OAuth app.
ALPACA_OAUTH_CLIENT_ID=replace-with-alpaca-client-id
ALPACA_OAUTH_CLIENT_SECRET=replace-with-alpaca-client-secret

# This value must exactly match a redirect URI registered in Alpaca.
ALPACA_OAUTH_REDIRECT_URI=http://localhost:3000/api/alpaca/oauth/callback

# Generate both values locally; do not reuse the Alpaca secret.
TRADINGLAB_ALPACA_OAUTH_STATE_SECRET=replace-with-a-random-secret
TRADINGLAB_ALPACA_TOKEN_ENCRYPTION_KEY=replace-with-a-base64url-32-byte-key

# Direct owner-only Paper bridge. These values stay on the server and are not
# sent to React or mobile browsers.
TRADINGLAB_EXECUTION_ENV=paper
TRADINGLAB_MARKET_DATA_FEED=iex
TRADINGLAB_REALTIME_ENABLED=true
TRADINGLAB_EXECUTION_ENABLED=false
TRADINGLAB_PAPER_ENABLED=false
TRADINGLAB_LIVE_ENABLED=false
TRADINGLAB_KILL_SWITCH=true
TRADINGLAB_MAX_ORDER_NOTIONAL_USD=500
TRADINGLAB_MAX_ORDER_QUANTITY=10
TRADINGLAB_ALLOWED_SYMBOLS=SPY,IWM,EFA,TLT,GLD
ALPACA_API_KEY=replace-with-paper-api-key
ALPACA_API_SECRET=replace-with-paper-api-secret
